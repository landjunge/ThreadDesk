{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/landjunge/ThreadDesk/blob/main/docs/contracts/status-v1.schema.json",
  "title": "STATUS.json · status-v1",
  "description": "Maschinenlesbares Ist-Stand-Register eines Produkts (Big Plan BP-TRUTH-01). Unbekanntes steht als \"unknown\", nie geraten.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "product", "repo", "observed_at", "main_pin", "source_version", "releases", "installed", "server", "open_packages"],
  "properties": {
    "schema": {"const": "status-v1"},
    "product": {"type": "string", "minLength": 1},
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "visibility", "default_branch"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "visibility": {"enum": ["public", "private"]},
        "default_branch": {"type": "string", "minLength": 1}
      }
    },
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "plan": {"type": "string"},
    "main_pin": {
      "description": "Stand des Standardbranches zum Beobachtungszeitpunkt. Der Pin darf hinter dem Branch zurückliegen (die Datei selbst erzeugt einen neuen Commit); er muss ein Vorfahr sein.",
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "committed_at"],
      "properties": {
        "commit": {"$ref": "#/$defs/sha"},
        "committed_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "source_version": {"$ref": "#/$defs/versionOrUnknown"},
    "releases": {
      "description": "Veröffentlichte (und Entwurfs-)Releases laut `gh release list`, neueste zuerst. Bei Produkten mit mehreren Kanälen die jeweils letzte je Kanal.",
      "oneOf": [{"const": "unknown"}, {"type": "array", "items": {"$ref": "#/$defs/release"}}]
    },
    "installed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mac"],
      "properties": {
        "mac": {"$ref": "#/$defs/macInstall"},
        "windows": {"$ref": "#/$defs/platformInstall"},
        "linux": {"$ref": "#/$defs/platformInstall"}
      }
    },
    "server": {
      "oneOf": [
        {"const": "unknown"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "observed_at", "components"],
          "properties": {
            "source": {"type": "string", "minLength": 1},
            "observed_at": {"$ref": "#/$defs/timestamp"},
            "components": {"type": "array", "items": {"$ref": "#/$defs/serverComponent"}}
          }
        }
      ]
    },
    "open_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["open", "in-progress", "blocked", "done", "unknown"]},
          "note": {"type": "string"}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "shaOrUnknown": {"oneOf": [{"const": "unknown"}, {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}]},
    "versionOrUnknown": {"type": "string", "minLength": 1},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "draft", "prerelease", "published_at", "assets"],
      "properties": {
        "tag": {"type": "string", "minLength": 1},
        "draft": {"type": "boolean"},
        "prerelease": {"type": "boolean"},
        "published_at": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"const": null}]},
        "assets": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "macInstall": {
      "oneOf": [
        {"const": "unknown"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "observed_at"],
          "properties": {
            "state": {"enum": ["installed", "not-installed"]},
            "observed_at": {"$ref": "#/$defs/timestamp"},
            "checked_paths": {"type": "array", "items": {"type": "string"}},
            "entries": {"type": "array", "items": {"$ref": "#/$defs/installEntry"}}
          }
        }
      ]
    },
    "platformInstall": {"const": "unknown"},
    "installEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "version", "source_commit"],
      "properties": {
        "kind": {"enum": ["app", "launcher"]},
        "path": {"type": "string", "minLength": 1},
        "version": {"$ref": "#/$defs/versionOrUnknown"},
        "source_commit": {"$ref": "#/$defs/shaOrUnknown"},
        "version_key": {"type": "string"},
        "commit_key": {"type": "string"},
        "runtime_marker": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "serverComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "state", "version", "source_commit", "exposure"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "unit": {"type": "string"},
        "state": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_commit": {"$ref": "#/$defs/shaOrUnknown"},
        "exposure": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      }
    }
  }
}
